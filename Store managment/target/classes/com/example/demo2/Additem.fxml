<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo2.AdditemController">
    <children>
        <Label layoutX="395.0" layoutY="35.0" prefHeight="59.0" prefWidth="95.0" text="Add Item" textAlignment="CENTER" underline="true">
            <font>
                <Font name="Arial Bold" size="18.0" />
            </font>
        </Label>
        <Label layoutX="285.0" layoutY="104.0" text="Item Name:" />
        <TextField fx:id="add_name" layoutX="378.0" layoutY="101.0" />
        <Label layoutX="285.0" layoutY="138.0" text="Cost Price :" />
        <TextField fx:id="add_cost" layoutX="378.0" layoutY="135.0" />
        <Label layoutX="285.0" layoutY="206.0" text="Quantity :" />
        <TextField fx:id="add_quantity" layoutX="378.0" layoutY="203.0" />
        <Label layoutX="285.0" layoutY="174.0" text="Selling price :" />
        <TextField fx:id="add_selling" layoutX="378.0" layoutY="171.0" />
        <Button fx:id="submit" layoutX="354.0" layoutY="250.0" mnemonicParsing="false" onAction="#add_item" prefHeight="30.0" prefWidth="198.0" text="Add Item" />
        <Label fx:id="add_message" layoutX="100.0" layoutY="294.0" prefHeight="39.0" prefWidth="702.0">
         <font>
            <Font name="Arial" size="24.0" />
         </font></Label>
    </children>
</AnchorPane>
