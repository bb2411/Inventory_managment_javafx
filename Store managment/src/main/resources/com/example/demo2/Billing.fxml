<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo2.BillingController">
    <children>
        <Label layoutX="190.0" layoutY="75.0" text="Item_code :" />
        <Label layoutX="443.0" layoutY="75.0" text="Quantity :" />
        <TextField fx:id="bill_code" layoutX="269.0" layoutY="72.0" promptText="code" />
        <TextField fx:id="bill_quantity" layoutX="508.0" layoutY="71.0" promptText="quantity" />
        <Button layoutX="350.0" layoutY="116.0" mnemonicParsing="false" onAction="#add_next_item" text="Add Next" />
        <Button layoutX="616.0" layoutY="116.0" mnemonicParsing="false" onAction="#generate_bill" text="Bill" />
        <TableView fx:id="bill_items" editable="true" layoutX="32.0" layoutY="208.0" prefHeight="422.0" prefWidth="846.0">
            <columns>
                <TableColumn fx:id="bill_item_code" prefWidth="75.0" text="item_code" />
                <TableColumn fx:id="bill_item_name" prefWidth="112.0" text="item_name" />
                <TableColumn fx:id="bill_item_quantity" prefWidth="92.79998779296875" text="Quantity" />
                <TableColumn fx:id="bill_item_mrp" prefWidth="86.4000244140625" text="MRP" />
                <TableColumn fx:id="bill_item_total" prefWidth="98.4000244140625" text="Total" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <TextField fx:id="grand_total" disable="true" editable="false" layoutX="356.0" layoutY="165.0" />
        <Label layoutX="269.0" layoutY="168.0" text="Grand Total  :" />
        <Label layoutX="393.0" layoutY="28.0" text="Billing Desk" underline="true">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
      <TextField layoutX="443.0" fx:id="customer_name" layoutY="116.0" promptText="customer name" />
    </children>
</AnchorPane>
