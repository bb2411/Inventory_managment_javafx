<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo2.InventoryController">
    <children>
        <TableView fx:id="list_inventory" editable="true" layoutX="22.0" layoutY="160.0" prefHeight="473.0" prefWidth="854.0">
            <columns>
                <TableColumn fx:id="list_code" prefWidth="75.0" text="item_code" />
                <TableColumn fx:id="list_name" prefWidth="112.0" text="item_name" />
                <TableColumn fx:id="list_quantity" prefWidth="92.79998779296875" text="Quantity" />
                <TableColumn fx:id="list_cost" prefWidth="86.4000244140625" text="Cost_price" />
                <TableColumn fx:id="list_selling" prefWidth="98.4000244140625" text="Selling_price" />
                <TableColumn fx:id="list_profit" prefWidth="87.19998779296873" text="Profit" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Label layoutX="137.0" layoutY="105.0" text="Item_name :" />
        <Label layoutX="371.0" layoutY="105.0" text="Item_code :" />
        <TextField fx:id="list_all_name" layoutX="219.0" layoutY="101.0" prefHeight="26.0" prefWidth="145.0" />
        <TextField fx:id="list_all_code" layoutX="446.0" layoutY="101.0" prefHeight="26.0" prefWidth="145.0" />
        <Button layoutX="616.0" layoutY="99.0" mnemonicParsing="false" onAction="#search_item_in_list" text="Search" />
        <Label layoutX="362.0" layoutY="23.0" text="Inventory" underline="true">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
      <ToggleButton fx:id="search_type_inventory" layoutX="310.0" layoutY="61.0" mnemonicParsing="false" onAction="#search_item_type" prefHeight="26.0" prefWidth="186.0" text="Search using Name or Code" />
      <Button layoutX="689.0" layoutY="99.0" mnemonicParsing="false" onAction="#load_data_to_list" text="Refresh" />
    </children>
</AnchorPane>
